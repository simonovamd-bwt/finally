{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/review-on-stop.sh\"",
            "timeout": 180,
            "statusMessage": "Reviewing changes since last commit → planning/review.md"
          }
        ]
      }
    ]
  }
}
