{
  "name": "finally",
  "version": "0.1.0",
  "private": true,
  "description": "Finally (Finance Ally) — a single-container, AI-powered simulated trading workstation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace shared && npm run build --workspace web && npm run build --workspace server",
    "build:shared": "npm run build --workspace shared",
    "build:server": "npm run build --workspace server",
    "build:web": "npm run build --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "start": "node server/dist/index.js",
    "clean": "rm -rf shared/dist server/dist web/dist"
  }
}
